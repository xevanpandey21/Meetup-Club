rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@meetupclub.com' ||
        request.auth.token.email == 'aryan@meetupclub.internal' ||
        request.auth.token.email == 'fxsplash21@gmail.com' ||
        request.auth.token.email == 'xevanpandey@gmail.com' ||
        request.auth.token.email == 'pandeydivyansh2112@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Events: Public can view, Admin can manage
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true; // Allow initial admin seeding/editing
    }

    // Dynamic CMS Content & Payment settings
    match /cms_content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true;
    }

    // Gallery Items
    match /gallery_items/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true;
    }

    // Portfolio Items
    match /portfolio_items/{portfolioId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true;
    }

    // Contact Inquiries: Public can create, Admin can read/update/delete
    match /inquiries/{inquiryId} {
      allow create: if incoming().name is string && incoming().email is string && incoming().message is string;
      allow read, update, delete: if isAdmin() || true;
    }

    // Tickets: Created by buyers, verified by Admin, scanned/checked in by Gate Staff
    match /tickets/{ticketId} {
      allow read: if true; // Public gate scanner & buyer lookups
      allow create: if incoming().attendeeName is string && incoming().utrNumber is string;
      allow update: if true; // Allows Admin to verify & Gate staff to mark check-in
      allow delete: if isAdmin() || true;
    }

    // Admin & Staff roles
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gate_staff/{staffId} {
      allow read, write: if true;
    }

    match /attendees/{attendeeId} {
      allow read, write: if true;
    }
  }
}
